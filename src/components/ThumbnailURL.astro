---
interface Props {
  url: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}

const {
  url,
  alt = "Website thumbnail",
  width = 480,
  height = 270,
  class: className = "",
} = Astro.props;

const isValid = typeof url === "string" && url.trim() !== "";
const thumbnailURL = isValid
  ? `https://image.thum.io/get/width/${width}/crop/768/${url}`
  : null;
---

{
  isValid ? (
    <img
      src={thumbnailURL}
      alt={alt}
      width={width}
      height={height}
      class={`thumb aspect-[16/9] ${className}`}
      loading="lazy"
    />
  ) : (
    <p>No se proporcionó una URL válida.</p>
  )
}

<style>
  .thumb {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 20px;
  }
</style>
