---
const { url } = Astro.props;
const thumbnailURL = `https://image.thum.io/get/width/480/crop/768/${encodeURIComponent(url)}`;
---

<style>
  .thumbnail-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f0f0f0;
    margin-bottom: 20px;
  }

  .spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .spinner::after {
    content: "";
    width: 40px;
    height: 40px;
    border: 4px solid #ccc;
    border-top-color: #333;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .thumb {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
    aspect-ratio: 16/9;
  }

  .thumb.loaded {
    opacity: 1;
  }
</style>

<div class="thumbnail-wrapper" client:load>
  <div class="spinner" id="spinner"></div>
  <img
    src={thumbnailURL}
    alt="Website thumbnail"
    class="thumb"
    id="thumbnail"
    width="480"
    height="auto"
    on:load={() => {
      document.getElementById("spinner")?.remove();
      document.getElementById("thumbnail")?.classList.add("loaded");
    }}
  />
</div>
