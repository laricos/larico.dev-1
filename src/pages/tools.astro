---
import Layout from "../layouts/BlogPost.astro";
import EditThisPost from "@/components/EditThisPost.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import ThumbnailURL from "@/components/ThumbnailURL.astro";
---

<Layout
  class:list={["tools-page"]}
  title="Tools ✨"
  description="Websites, apps, AI tools, and more — everything you need, all in one place."
>
  <div class="cols">
    <div class="col">
      <h2>AI Tools</h2>
      <br />

      <ul class="ul_reset links">
        <li>
          <ExternalLink title="Freepik" href="https://www.freepik.com/">
            <ThumbnailURL url="https://www.freepik.com" />
            <h3><span>Freepik</span></h3>
          </ExternalLink>

          <p>
            Generación ilimitada de imágenes y vídeos con IA para usuarios
            Premium+ y Pro. Es ideal para diseñadores y creadores que buscan
            velocidad, variedad y calidad. una de sus características es
            agrandar imagen (upscale).
          </p>
        </li>
      </ul>
    </div>
  </div>

  <EditThisPost sourcePath="src/pages/tools.astro" />
</Layout>

<style>
  .links {
    a {
      text-decoration: none;
    }
  }
</style>
