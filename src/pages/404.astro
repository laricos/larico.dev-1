---
import Layout from "../layouts/BlogPost.astro";

import { SITE_INFO } from "../consts";
---

<Layout class:list={["about"]} title="404 - Page Not Found">
  <div class="not-found">
    <p>Sorry, the page you are looking for does not exist.</p>
    <p>
      You can return to the <a href="/">home page</a> or visit the
      <a href="/blog">blog</a>.
    </p>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
  }
</style>
